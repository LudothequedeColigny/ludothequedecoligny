# CONFIGURATION DE L'APPLICATION
# Durée par défaut d'un prêt en jours
VITE_DUREE_PRET_DEFAUT=14

# Nombre maximum de prêts simultanés par adhérent
VITE_LIMITE_PRETS_SIMULTANES=3

# Durée de cotisation en mois
VITE_DUREE_COTISATION_MOIS=12

# Mode de l'application (development, production)
VITE_APP_MODE=development

# URL de l'application (pour les emails, etc.)
